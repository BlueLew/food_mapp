<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Food Mapp" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Food Mapp">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="google-maps-api-key" content="<%= ENV.fetch("GOOGLE_MAPS_API_KEY", "") %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-[radial-gradient(circle_at_top,_#fef3c7_0%,_#fff7ed_45%,_#fafaf9_100%)] text-stone-900">
    <div class="min-h-screen">
      <header class="border-b border-stone-200/80 bg-white/70 backdrop-blur">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
          <div>
            <%= link_to root_path, class: "block" do %>
              <span class="font-['Fraunces'] text-3xl font-semibold tracking-tight text-amber-950">Food Mapp</span>
              <span class="block text-sm text-stone-500">Taste shaped by where we have lived.</span>
            <% end %>
          </div>

          <nav class="flex items-center gap-3 text-sm font-medium">
            <%= link_to "Explore", venues_path, class: "rounded-full px-4 py-2 text-stone-700 transition hover:bg-stone-100" %>
            <% if authenticated? %>
              <%= link_to "Profile", profile_path, class: "rounded-full px-4 py-2 text-stone-700 transition hover:bg-stone-100" %>
              <%= link_to "Residences", residences_path, class: "rounded-full px-4 py-2 text-stone-700 transition hover:bg-stone-100" %>
              <% if admin_user? %>
                <%= link_to "Admin", admin_venues_path, class: "rounded-full bg-stone-900 px-4 py-2 text-white transition hover:bg-stone-700" %>
              <% end %>
              <%= button_to "Log out", session_path, method: :delete, class: "cursor-pointer rounded-full bg-amber-600 px-4 py-2 text-white transition hover:bg-amber-500" %>
            <% else %>
              <%= link_to "Sign in", new_session_path, class: "rounded-full px-4 py-2 text-stone-700 transition hover:bg-stone-100" %>
              <%= link_to "Create account", new_registration_path, class: "rounded-full bg-stone-900 px-4 py-2 text-white transition hover:bg-stone-700" %>
            <% end %>
          </nav>
        </div>
      </header>

      <main class="mx-auto max-w-7xl px-6 py-10">
        <% flash.each do |type, message| %>
          <div class="mb-6 rounded-2xl border px-4 py-3 text-sm font-medium shadow-sm <%= flash_class(type) %>">
            <%= message %>
          </div>
        <% end %>

        <%= yield %>
      </main>
    </div>
  </body>
  </html>
