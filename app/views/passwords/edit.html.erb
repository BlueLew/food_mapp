<section class="mx-auto max-w-2xl panel p-8 lg:p-10">
  <p class="text-sm uppercase tracking-[0.3em] text-amber-700">Password reset</p>
  <h1 class="mt-3 text-4xl font-semibold text-amber-950">Set a new password</h1>

  <%= form_with url: password_path(params[:token]), method: :put, class: "mt-8 space-y-6" do |form| %>
    <div>
      <%= form.label :password, "New password", class: "text-sm font-semibold text-stone-700" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
    </div>

    <div>
      <%= form.label :password_confirmation, "Confirm password", class: "text-sm font-semibold text-stone-700" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
    </div>

    <%= form.submit "Save password", class: "button-primary cursor-pointer" %>
  <% end %>
</section>
