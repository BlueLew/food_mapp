<section class="mx-auto max-w-2xl panel p-8 lg:p-10">
  <p class="text-sm uppercase tracking-[0.3em] text-amber-700">Password reset</p>
  <h1 class="mt-3 text-4xl font-semibold text-amber-950">Forgot your password?</h1>
  <p class="mt-4 text-stone-600">Enter the email address on your account and we will send you reset instructions.</p>

  <%= form_with url: passwords_path, class: "mt-8 space-y-6" do |form| %>
    <div>
      <%= form.label :email_address, "Email address", class: "text-sm font-semibold text-stone-700" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "input" %>
    </div>

    <div class="flex flex-wrap items-center gap-4">
      <%= form.submit "Email reset instructions", class: "button-primary cursor-pointer" %>
      <%= link_to "Back to sign in", new_session_path, class: "text-sm font-medium text-stone-600 underline-offset-4 hover:text-stone-900 hover:underline" %>
    </div>
  <% end %>
</section>
