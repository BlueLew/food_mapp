<section class="space-y-8">
  <div class="flex flex-wrap items-start justify-between gap-6">
    <div>
      <p class="text-sm uppercase tracking-[0.3em] text-amber-700"><%= @venue.category %></p>
      <h1 class="mt-3 text-5xl font-semibold text-amber-950"><%= @venue.name %></h1>
      <p class="mt-4 max-w-2xl text-lg leading-8 text-stone-600"><%= @venue.address %></p>
    </div>
    <div class="flex flex-wrap gap-3">
      <%= render "like_button", venue: @venue %>
      <%= link_to "Back to venues", venues_path, class: "button-muted" %>
    </div>
  </div>

  <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr]">
    <div class="space-y-8">
      <div class="panel p-6">
        <div class="grid gap-4 sm:grid-cols-3">
          <div class="subtle-panel p-4">
            <p class="text-sm uppercase tracking-[0.25em] text-stone-500">Likes</p>
            <p class="mt-2 text-3xl font-semibold text-stone-950"><%= @venue.likes.count %></p>
          </div>
          <div class="subtle-panel p-4">
            <p class="text-sm uppercase tracking-[0.25em] text-stone-500">Residences</p>
            <p class="mt-2 text-3xl font-semibold text-stone-950"><%= @venue.liked_residences.count %></p>
          </div>
          <div class="subtle-panel p-4">
            <p class="text-sm uppercase tracking-[0.25em] text-stone-500">Website</p>
            <% if @venue.website.present? %>
              <%= link_to "Visit", @venue.website, target: "_blank", rel: "noreferrer", class: "mt-2 inline-block text-lg font-semibold text-amber-700 underline-offset-4 hover:underline" %>
            <% else %>
              <p class="mt-2 text-lg font-semibold text-stone-500">N/A</p>
            <% end %>
          </div>
        </div>

        <div class="mt-6 space-y-3 text-sm leading-7 text-stone-600">
          <% if @venue.phone.present? %>
            <p><span class="font-semibold text-stone-800">Phone:</span> <%= @venue.phone %></p>
          <% end %>
          <% if @venue.photo.attached? %>
            <%= image_tag @venue.photo, class: "mt-4 h-72 w-full rounded-[1.75rem] object-cover" %>
          <% end %>
        </div>
      </div>

      <div class="panel p-6">
        <h2 class="text-3xl font-semibold text-stone-900">Maps</h2>
        <div class="mt-6 grid gap-6">
          <div>
            <h3 class="text-lg font-semibold text-stone-800">Venue location</h3>
            <div class="mt-3 h-72 rounded-[1.75rem] border border-stone-200 bg-stone-100"
                 data-controller="map"
                 data-map-api-key-value="<%= ENV.fetch("GOOGLE_MAPS_API_KEY", "") %>"
                 data-map-markers-value="<%= json_escape(@venue_markers.to_json) %>"
                 data-map-zoom-value="14"></div>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-stone-800">Where the likes come from</h3>
            <div class="mt-3 h-80 rounded-[1.75rem] border border-stone-200 bg-stone-100"
                 data-controller="map"
                 data-map-api-key-value="<%= ENV.fetch("GOOGLE_MAPS_API_KEY", "") %>"
                 data-map-markers-value="<%= json_escape(@residence_markers.to_json) %>"
                 data-map-zoom-value="3"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="panel p-6">
      <h2 class="text-3xl font-semibold text-stone-900">Liked most by people from</h2>
      <div class="mt-6 grid gap-5 md:grid-cols-3">
        <% { "Cities" => @city_breakdown, "States" => @state_breakdown, "Countries" => @country_breakdown }.each do |label, groups| %>
          <section class="subtle-panel p-4">
            <h3 class="text-lg font-semibold text-stone-900"><%= label %></h3>
            <ul class="mt-4 space-y-3 text-sm text-stone-600">
              <% if groups.any? %>
                <% groups.each do |group| %>
                  <li class="flex items-start justify-between gap-3">
                    <span><%= group[:name] %></span>
                    <span class="rounded-full bg-white px-3 py-1 font-semibold text-stone-900"><%= pluralize(group[:likes], "like") %></span>
                  </li>
                <% end %>
              <% else %>
                <li>No residence data yet.</li>
              <% end %>
            </ul>
          </section>
        <% end %>
      </div>
    </div>
  </div>
</section>
