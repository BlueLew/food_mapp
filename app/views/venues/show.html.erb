<section class="space-y-8">
  <div class="flex flex-wrap items-start justify-between gap-6">
    <div>
      <p class="text-sm uppercase tracking-[0.3em] text-amber-700"><%= @venue.category %></p>
      <h1 class="mt-3 text-5xl font-semibold text-amber-950"><%= @venue.name %></h1>
      <p class="mt-4 max-w-2xl text-lg leading-8 text-stone-600"><%= @venue.address %></p>
    </div>
    <div class="flex flex-wrap gap-3">
      <%= render "like_button", venue: @venue, liked: @liked %>
      <%= link_to "Back to venues", venues_path, class: "button-muted" %>
    </div>
  </div>

  <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr]">
    <div class="space-y-8">
      <%= render "quick_stats", venue: @venue %>

      <div class="panel p-6">
        <h2 class="text-3xl font-semibold text-stone-900">Maps</h2>
        <div class="mt-6 grid gap-6">
          <div>
            <h3 class="text-lg font-semibold text-stone-800">Venue location</h3>
            <div class="mt-3 h-72 rounded-[1.75rem] border border-stone-200 bg-stone-100"
                 data-controller="map"
                 data-map-tile-url-value="<%= map_tile_url %>"
                 data-map-attribution-value="<%= map_attribution %>"
                 data-map-markers-value="<%= json_escape(@venue_markers.to_json) %>"
                 data-map-zoom-value="14"></div>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-stone-800">Where the likes come from</h3>
            <div class="mt-3 h-80 rounded-[1.75rem] border border-stone-200 bg-stone-100"
                 data-controller="map"
                 data-map-tile-url-value="<%= map_tile_url %>"
                 data-map-attribution-value="<%= map_attribution %>"
                 data-map-markers-value="<%= json_escape(@residence_markers.to_json) %>"
                 data-map-zoom-value="3"></div>
          </div>
        </div>
      </div>
    </div>

    <%= render "origin_breakdowns", venue: @venue %>
  </div>
</section>
