<div id="<%= dom_id(venue, :origin_breakdowns) %>" class="panel p-6">
  <h2 class="text-3xl font-semibold text-stone-900">Liked most by people from</h2>
  <div class="mt-6 grid gap-5 md:grid-cols-3">
    <% {
      "Cities" => venue.likes_by(:city),
      "States" => venue.likes_by(:state),
      "Countries" => venue.likes_by(:country)
    }.each do |label, groups| %>
      <section class="subtle-panel p-4">
        <h3 class="text-lg font-semibold text-stone-900"><%= label %></h3>
        <ul class="mt-4 space-y-3 text-sm text-stone-600">
          <% if groups.any? %>
            <% groups.each do |group| %>
              <li class="flex items-start justify-between gap-3">
                <span><%= group[:name] %></span>
                <span class="rounded-full bg-white px-3 py-1 font-semibold text-stone-900"><%= pluralize(group[:likes], "like") %></span>
              </li>
            <% end %>
          <% else %>
            <li>No residence data yet.</li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
</div>
