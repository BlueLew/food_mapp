<div id="<%= dom_id(venue, :quick_stats) %>" class="panel p-6">
  <div class="grid gap-4 sm:grid-cols-3">
    <div class="subtle-panel p-4">
      <p class="text-sm uppercase tracking-[0.25em] text-stone-500">Likes</p>
      <p class="mt-2 text-3xl font-semibold text-stone-950"><%= venue.likes.count %></p>
    </div>
    <div class="subtle-panel p-4">
      <p class="text-sm uppercase tracking-[0.25em] text-stone-500">Residences</p>
      <p class="mt-2 text-3xl font-semibold text-stone-950"><%= venue.liked_residences.count %></p>
    </div>
    <div class="subtle-panel p-4">
      <p class="text-sm uppercase tracking-[0.25em] text-stone-500">Website</p>
      <% if venue.website.present? %>
        <%= link_to "Visit", venue.website, target: "_blank", rel: "noreferrer", class: "mt-2 inline-block text-lg font-semibold text-amber-700 underline-offset-4 hover:underline" %>
      <% else %>
        <p class="mt-2 text-lg font-semibold text-stone-500">N/A</p>
      <% end %>
    </div>
  </div>

  <div class="mt-6 space-y-3 text-sm leading-7 text-stone-600">
    <% if venue.phone.present? %>
      <p><span class="font-semibold text-stone-800">Phone:</span> <%= venue.phone %></p>
    <% end %>
    <% if venue.photo.attached? %>
      <%= image_tag venue.photo, class: "mt-4 h-72 w-full rounded-[1.75rem] object-cover" %>
    <% end %>
  </div>
</div>
