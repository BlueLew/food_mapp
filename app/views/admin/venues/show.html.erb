<section class="space-y-8">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-sm uppercase tracking-[0.3em] text-amber-700">Admin venue</p>
      <h1 class="mt-3 text-4xl font-semibold text-amber-950"><%= @venue.name %></h1>
      <p class="mt-2 text-stone-600"><%= @venue.address %></p>
    </div>
    <div class="flex flex-wrap gap-3">
      <%= link_to "Edit", edit_admin_venue_path(@venue), class: "button-primary" %>
      <%= button_to "Delete", admin_venue_path(@venue), method: :delete, class: "button-secondary cursor-pointer", form: { data: { turbo_confirm: "Delete this venue?" } } %>
    </div>
  </div>

  <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr]">
    <div class="panel p-6">
      <% if @venue.photo.attached? %>
        <%= image_tag @venue.photo, class: "h-80 w-full rounded-[1.75rem] object-cover" %>
      <% end %>

      <div class="mt-6 space-y-3 text-sm text-stone-600">
        <p><span class="font-semibold text-stone-800">Category:</span> <%= @venue.category %></p>
        <p><span class="font-semibold text-stone-800">Phone:</span> <%= @venue.phone.presence || "N/A" %></p>
        <p><span class="font-semibold text-stone-800">Website:</span> <%= @venue.website.presence || "N/A" %></p>
        <p><span class="font-semibold text-stone-800">Coordinates:</span> <%= [@venue.latitude, @venue.longitude].compact.join(", ").presence || "Not geocoded yet" %></p>
      </div>
    </div>

    <div class="panel p-6">
      <h2 class="text-3xl font-semibold text-stone-900">City breakdown</h2>
      <div class="mt-5 space-y-3">
        <% @city_breakdown.each do |group| %>
          <div class="subtle-panel flex items-center justify-between p-4">
            <span class="font-medium text-stone-900"><%= group[:name] %></span>
            <span class="rounded-full bg-white px-3 py-1 text-sm font-semibold text-stone-900"><%= pluralize(group[:likes], "like") %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
