<section class="space-y-8">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-sm uppercase tracking-[0.3em] text-amber-700">Admin</p>
      <h1 class="mt-3 text-4xl font-semibold text-amber-950">Users</h1>
    </div>
    <%= form_with url: admin_users_path, method: :get, class: "w-full max-w-md" do |form| %>
      <%= form.text_field :query, value: @query, placeholder: "Search by name or email", class: "input mt-0" %>
    <% end %>
  </div>

  <div class="panel overflow-hidden">
    <table class="min-w-full divide-y divide-stone-200 text-sm">
      <thead class="bg-stone-50 text-left text-stone-500">
        <tr>
          <th class="px-6 py-4 font-semibold">Name</th>
          <th class="px-6 py-4 font-semibold">Email</th>
          <th class="px-6 py-4 font-semibold">Role</th>
          <th class="px-6 py-4 font-semibold">Likes</th>
          <th class="px-6 py-4"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-100 bg-white">
        <% @users.each do |user| %>
          <tr>
            <td class="px-6 py-4 font-medium text-stone-900"><%= user.display_name %></td>
            <td class="px-6 py-4 text-stone-600"><%= user.email_address %></td>
            <td class="px-6 py-4 text-stone-600"><%= user.role %></td>
            <td class="px-6 py-4 text-stone-600"><%= user.likes.size %></td>
            <td class="px-6 py-4 text-right"><%= link_to "Manage", admin_user_path(user), class: "text-amber-700 underline-offset-4 hover:underline" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
