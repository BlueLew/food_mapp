<section class="space-y-8">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-sm uppercase tracking-[0.3em] text-amber-700">Admin user</p>
      <h1 class="mt-3 text-4xl font-semibold text-amber-950"><%= @user.display_name %></h1>
      <p class="mt-2 text-stone-600"><%= @user.email_address %></p>
    </div>
    <div class="flex flex-wrap gap-3">
      <%= link_to "Edit", edit_admin_user_path(@user), class: "button-primary" %>
      <%= button_to "Delete", admin_user_path(@user), method: :delete, class: "button-secondary cursor-pointer", form: { data: { turbo_confirm: "Delete this user?" } } %>
    </div>
  </div>

  <div class="grid gap-8 lg:grid-cols-2">
    <div class="panel p-6">
      <h2 class="text-3xl font-semibold text-stone-900">Residence history</h2>
      <div class="mt-5 space-y-3">
        <% @residences.each do |residence| %>
          <div class="subtle-panel p-4">
            <p class="font-semibold text-stone-900"><%= residence.city %><%= ", #{residence.state}" if residence.state.present? %></p>
            <p class="text-sm text-stone-600"><%= residence.country %></p>
          </div>
        <% end %>
      </div>
    </div>

    <div class="panel p-6">
      <h2 class="text-3xl font-semibold text-stone-900">Liked venues</h2>
      <div class="mt-5 space-y-3">
        <% @liked_venues.each do |venue| %>
          <div class="subtle-panel p-4">
            <p class="font-semibold text-stone-900"><%= venue.name %></p>
            <p class="text-sm text-stone-600"><%= venue.category %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
