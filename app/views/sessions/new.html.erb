<section class="mx-auto grid max-w-5xl gap-8 lg:grid-cols-[1.2fr_0.8fr]">
  <div class="panel p-8 lg:p-10">
    <p class="text-sm uppercase tracking-[0.3em] text-amber-700">Welcome back</p>
    <h1 class="mt-3 text-4xl font-semibold text-amber-950">Sign in to keep mapping taste to place.</h1>
    <p class="mt-4 max-w-xl text-stone-600">Browse venues, update your residence history, and see which places resonate most with people from the same corners of the world.</p>

    <%= form_with url: session_url, class: "mt-8 space-y-6" do |form| %>
      <div>
        <%= form.label :email_address, "Email address", class: "text-sm font-semibold text-stone-700" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "input" %>
      </div>

      <div>
        <%= form.label :password, class: "text-sm font-semibold text-stone-700" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "input" %>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <%= form.submit "Sign in", class: "button-primary cursor-pointer" %>
        <%= link_to "Forgot password?", new_password_path, class: "text-sm font-medium text-stone-600 underline-offset-4 hover:text-stone-900 hover:underline" %>
      </div>
    <% end %>
  </div>

  <aside class="subtle-panel p-8">
    <p class="text-sm uppercase tracking-[0.3em] text-stone-500">New here?</p>
    <h2 class="mt-3 text-3xl font-semibold text-stone-900">Create an account.</h2>
    <p class="mt-4 text-stone-600">Start with the places you love, then layer in the cities and countries that shaped your palate.</p>
    <%= link_to "Create account", new_registration_path, class: "button-secondary mt-8" %>
  </aside>
</section>
</div>
